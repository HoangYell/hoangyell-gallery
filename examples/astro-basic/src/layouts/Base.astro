---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "@hoangyell/gallery — The friendly Astro image gallery",
  description = "Lightbox. Pyramid layout. Dark mode. Accessible. Zero config. The friendly Astro image gallery component, free and open-source.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/og.png", Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#020617" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Hoang Yell" />
    <meta name="keywords" content="astro, gallery, lightbox, image gallery, photo gallery, astro component, mdx, accessibility" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="@hoangyell/gallery" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Anti-FOUC theme bootstrap. Runs synchronously before paint. */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("hy-theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          const isDark = saved ? saved === "dark" : prefersDark;
          document.documentElement.classList.toggle("dark", isDark);
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>

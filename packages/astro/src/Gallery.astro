---
/**
 * @hoangyell/gallery — <Gallery /> component
 *
 * Image gallery with pyramid multi-row layout and accessible lightbox.
 * Tap/click to open, arrow keys / swipe to navigate, ESC to close.
 */

export type ObjectFit = "cover" | "contain" | "fill" | "none" | "scale-down";

export interface GalleryItemInput {
  src: string;
  alt?: string;
  fit?: ObjectFit;
}

export interface Props {
  /** Image URLs or { src, alt, fit } objects. */
  items?: (string | GalleryItemInput)[];
  /** Alt text array paired with string[] items. */
  alts?: string[];
  /** Extra CSS class on the wrapper. */
  class?: string;
  /** Number of visual rows (pyramid distribution). Auto if omitted. */
  rows?: number;
  /** Aspect ratio hint for items. */
  orientation?: "landscape" | "portrait";
  /** Scale factor to reduce gallery width (1 = full). */
  scale?: number;
  /** Global object-fit for all items unless overridden per-item. Auto: "contain" for 1 item, "cover" for multiple items. */
  fit?: ObjectFit;
  /** Enable zoom gestures (pinch, double-tap, pan, wheel) in lightbox. Defaults to true. */
  zoom?: boolean;
  /** Show visible zoom in/out/reset buttons in the lightbox toolbar. Defaults to false. */
  zoomControls?: boolean;
}

const {
  class: className = "",
  rows,
  orientation = "landscape",
  scale = 1,
  fit: explicitFit,
  zoom = true,
  zoomControls = false,
} = Astro.props;

const rawItems = Array.isArray(Astro.props.items) ? Astro.props.items : [];
const rawAlts = Array.isArray(Astro.props.alts) ? Astro.props.alts : [];

type GalleryItem = { src: string; alt: string; fit: string };

function altFromUrl(url: string): string {
  try {
    const filename = url.split("/").pop()?.split("?")[0] || "";
    return filename.replace(/\.[^.]+$/, "").replace(/[-_]/g, " ");
  } catch {
    return "";
  }
}

const validItemCount = rawItems.filter((item) => {
  if (typeof item === "string") return item.trim() !== "";
  return Boolean(item?.src);
}).length;
const defaultFit: ObjectFit = validItemCount <= 1 ? "contain" : "cover";
const resolvedFit: ObjectFit = explicitFit || defaultFit;

const galleryItems: GalleryItem[] = rawItems
  .map((item, i) => {
    if (typeof item === "string") {
      return {
        src: item,
        alt: rawAlts[i] || altFromUrl(item),
        fit: String(resolvedFit),
      };
    }
    const itemFit = item?.fit || resolvedFit;
    return {
      src: item?.src || "",
      alt: item?.alt || rawAlts[i] || altFromUrl(item?.src || ""),
      fit: String(itemFit),
    };
  })
  .filter((item) => item.src !== "");

const resolvedRows =
  rows !== undefined ? Math.max(1, rows) : Math.ceil(galleryItems.length / 3);

let groupedItems: GalleryItem[][] = [];

if (resolvedRows <= 1 || galleryItems.length <= 1) {
  groupedItems = [galleryItems];
} else {
  const n = galleryItems.length;
  const actualRows = Math.max(1, Math.min(resolvedRows, n));
  const base = Math.floor(n / actualRows);
  const remainder = n % actualRows;

  let idx = 0;
  for (let i = 0; i < actualRows; i++) {
    const isBottomRow = i >= actualRows - remainder;
    const rowSize = isBottomRow ? base + 1 : base;
    groupedItems.push(galleryItems.slice(idx, idx + rowSize));
    idx += rowSize;
  }
}
---

{
  galleryItems.length > 0 && (
    <div
      class={`hy-gallery ${className}`}
      data-hy-gallery
      data-orientation={orientation}
      data-fit={resolvedFit}
      data-zoom={zoom ? "true" : "false"}
      data-zoom-controls={zoomControls ? "true" : "false"}
      style={scale !== 1 ? `width: ${scale * 100}%; margin: 2rem auto;` : undefined}
    >
      {groupedItems.map((group, rowIdx) => {
        const isFirstRow = rowIdx === 0;
        const isLastRow = rowIdx === groupedItems.length - 1;
        return (
          <div class="hy-gallery-row" style={`--row-cols: ${group.length};`}>
            {group.map((item, colIdx) => {
              const isFirstCol = colIdx === 0;
              const isLastCol = colIdx === group.length - 1;
              const cornerClasses = [
                isFirstRow && isFirstCol && "is-tl",
                isFirstRow && isLastCol && "is-tr",
                isLastRow && isFirstCol && "is-bl",
                isLastRow && isLastCol && "is-br",
              ]
                .filter(Boolean)
                .join(" ");
              return (
                <button
                  type="button"
                  class={`hy-gallery-item ${cornerClasses}`}
                  data-zoom-src={item.src}
                  data-alt={item.alt}
                  data-fit={item.fit}
                  aria-label={
                    item.alt ? `View full size: ${item.alt}` : "View full size image"
                  }
                >
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                    class="hy-gallery-img"
                    style={`object-fit: ${item.fit} !important;`}
                  />
                </button>
              );
            })}
          </div>
        );
      })}
    </div>
  )
}

<style>
  /* ── Custom properties (override on .hy-gallery or :root) ── */
  .hy-gallery {
    --hy-gallery-gap: 4px;
    --hy-gallery-radius: 1rem;
    --hy-gallery-bg: #f8fafc;
    --hy-gallery-overlay-bg: rgba(255, 255, 255, 0.7);
    --hy-gallery-accent: #2563eb;
    --hy-gallery-border: #e2e8f0;
    --hy-gallery-text: #334155;
    --hy-gallery-control-bg: rgba(255, 255, 255, 0.95);
  }

  /* OS-level dark preference. */
  @media (prefers-color-scheme: dark) {
    .hy-gallery {
      --hy-gallery-bg: #0f172a;
      --hy-gallery-overlay-bg: rgba(2, 6, 23, 0.8);
      --hy-gallery-accent: #60a5fa;
      --hy-gallery-border: #334155;
      --hy-gallery-text: #e2e8f0;
      --hy-gallery-control-bg: rgba(30, 41, 59, 0.95);
    }
  }

  /* Explicit light theme on any ancestor wins over OS preference.
     Supports Tailwind-style `.light` class and `[data-theme="light"]`. */
  :where(.light, [data-theme="light"]) .hy-gallery {
    --hy-gallery-bg: #f8fafc;
    --hy-gallery-overlay-bg: rgba(255, 255, 255, 0.7);
    --hy-gallery-accent: #2563eb;
    --hy-gallery-border: #e2e8f0;
    --hy-gallery-text: #334155;
    --hy-gallery-control-bg: rgba(255, 255, 255, 0.95);
  }

  /* Explicit dark theme on any ancestor wins over OS preference.
     Supports Tailwind-style `.dark` class and `[data-theme="dark"]`. */
  :where(.dark, [data-theme="dark"]) .hy-gallery {
    --hy-gallery-bg: #0f172a;
    --hy-gallery-overlay-bg: rgba(2, 6, 23, 0.8);
    --hy-gallery-accent: #60a5fa;
    --hy-gallery-border: #334155;
    --hy-gallery-text: #e2e8f0;
    --hy-gallery-control-bg: rgba(30, 41, 59, 0.95);
  }

  .hy-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--hy-gallery-gap);
    margin-block: 2rem;
    margin-inline: -1rem;
  }

  @media (min-width: 640px) {
    .hy-gallery {
      margin-inline: 0;
    }
  }

  .hy-gallery-row {
    display: grid;
    gap: var(--hy-gallery-gap);
    grid-template-columns: repeat(var(--row-cols, 1), minmax(0, 1fr));
  }

  .hy-gallery-item {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
    background: var(--hy-gallery-bg);
    cursor: zoom-in;
    border: none;
    padding: 0;
    aspect-ratio: 4 / 3;
    contain: paint;
    isolation: isolate;
    transition: box-shadow 0.3s ease;
  }

  .hy-gallery-item.is-tl {
    border-top-left-radius: var(--hy-gallery-radius);
  }
  .hy-gallery-item.is-tr {
    border-top-right-radius: var(--hy-gallery-radius);
  }
  .hy-gallery-item.is-bl {
    border-bottom-left-radius: var(--hy-gallery-radius);
  }
  .hy-gallery-item.is-br {
    border-bottom-right-radius: var(--hy-gallery-radius);
  }

  @media (max-width: 639px) {
    .hy-gallery-item.is-tl,
    .hy-gallery-item.is-tr,
    .hy-gallery-item.is-bl,
    .hy-gallery-item.is-br {
      border-radius: 0;
    }
  }

  .hy-gallery[data-orientation="portrait"] .hy-gallery-item {
    aspect-ratio: 3 / 4;
  }

  @media (max-width: 639px) {
    .hy-gallery-item {
      aspect-ratio: 1 / 1;
    }
    .hy-gallery[data-orientation="portrait"] .hy-gallery-item {
      aspect-ratio: 4 / 5;
    }
  }

  /* fit="contain" — show the whole image at its natural aspect ratio.
     Drops the forced 4:3 / 1:1 container so diagrams, charts, screenshots,
     and tall portraits render fully without cropping or letterboxing.
     Applied either at the wrapper (global) or per-item via data-fit. */
  .hy-gallery[data-fit="contain"] .hy-gallery-item:not([data-fit="cover"]),
  .hy-gallery .hy-gallery-item[data-fit="contain"] {
    aspect-ratio: auto;
    background: transparent;
  }

  .hy-gallery-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    object-fit: cover;
    object-position: center;
    aspect-ratio: auto;
    max-width: none;
    max-height: none;
    transform-origin: center;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* In contain mode the image is the primary content — let it drive height
     instead of being absolutely positioned inside a fixed-aspect box. */
  .hy-gallery[data-fit="contain"] .hy-gallery-item:not([data-fit="cover"]) .hy-gallery-img,
  .hy-gallery .hy-gallery-item[data-fit="contain"] .hy-gallery-img {
    position: static;
    width: 100%;
    height: auto;
    inset: auto;
  }

  .hy-gallery-item:hover .hy-gallery-img,
  .hy-gallery-item:focus-visible .hy-gallery-img {
    will-change: transform;
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .hy-gallery-img {
      transition: none !important;
    }
    .hy-gallery-item:hover .hy-gallery-img,
    .hy-gallery-item:focus-visible .hy-gallery-img {
      transform: none !important;
    }
  }

  .hy-gallery-item:focus {
    outline: none;
  }

  .hy-gallery-item:focus-visible {
    outline: 2px solid var(--hy-gallery-accent);
    outline-offset: -2px;
    z-index: 1;
  }

  /* ── Lightbox overlay ── */
  :global(.hy-gallery-overlay) {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--hy-gallery-overlay-bg);
    backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity 0.3s ease;
    cursor: zoom-out;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  :global(.hy-gallery-overlay.is-active) {
    opacity: 1;
  }

  :global(.hy-gallery-overlay-content) {
    position: relative;
    width: 90vw;
    height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    touch-action: none;
  }

  :global(.hy-gallery-overlay-img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    border: 1px solid var(--hy-gallery-border);
    cursor: zoom-in;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    touch-action: none;
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.hy-gallery-overlay-img.is-zoomed) {
    cursor: grab;
  }

  :global(.hy-gallery-overlay-img.is-dragging) {
    cursor: grabbing !important;
  }

  :global(.hy-gallery-slide-anim) {
    animation: hy-gallery-slide-in 0.25s cubic-bezier(0.4, 0, 0.2, 1) forwards !important;
  }

  @keyframes hy-gallery-slide-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  :global(.hy-gallery-counter) {
    position: absolute;
    top: max(env(safe-area-inset-top, 0px), 16px);
    left: max(env(safe-area-inset-left, 0px), 16px);
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--hy-gallery-control-bg);
    border: 1px solid var(--hy-gallery-border);
    font-family: system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--hy-gallery-text);
    pointer-events: none;
    user-select: none;
    z-index: 10;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(4px);
  }

  :global(.hy-gallery-controls) {
    position: absolute;
    top: max(env(safe-area-inset-top, 0px), 16px);
    right: max(env(safe-area-inset-right, 0px), 16px);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 10;
  }

  :global(.hy-gallery-btn),
  :global(.hy-gallery-close) {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hy-gallery-border);
    border-radius: 9999px;
    background: var(--hy-gallery-control-bg);
    color: var(--hy-gallery-text);
    cursor: pointer;
    transition: transform 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    z-index: 10;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(4px);
    padding: 0;
  }

  :global(.hy-gallery-btn:hover),
  :global(.hy-gallery-btn:focus-visible),
  :global(.hy-gallery-close:hover),
  :global(.hy-gallery-close:focus-visible) {
    transform: scale(1.08);
    color: var(--hy-gallery-accent);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  :global(.hy-gallery-btn:disabled),
  :global(.hy-gallery-btn[aria-disabled="true"]) {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none !important;
    pointer-events: none;
  }

  :global(.hy-gallery-btn:focus),
  :global(.hy-gallery-close:focus),
  :global(.hy-gallery-nav:focus) {
    outline: none;
  }

  :global(.hy-gallery-btn:focus-visible),
  :global(.hy-gallery-close:focus-visible),
  :global(.hy-gallery-nav:focus-visible) {
    outline: 2px solid var(--hy-gallery-accent);
    outline-offset: 2px;
  }

  :global(.hy-gallery-nav) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hy-gallery-border);
    border-radius: 9999px;
    background: var(--hy-gallery-control-bg);
    color: var(--hy-gallery-text);
    cursor: pointer;
    transition: transform 0.2s ease;
    z-index: 10;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(4px);
  }

  :global(.hy-gallery-nav-prev) {
    left: max(env(safe-area-inset-left, 0px), 16px);
  }

  :global(.hy-gallery-nav-next) {
    right: max(env(safe-area-inset-right, 0px), 16px);
  }

  :global(.hy-gallery-nav:hover),
  :global(.hy-gallery-nav:focus-visible) {
    transform: translateY(-50%) scale(1.1);
    color: var(--hy-gallery-accent);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 639px) {
    :global(.hy-gallery-controls) {
      top: max(env(safe-area-inset-top, 0px), 8px);
      right: max(env(safe-area-inset-right, 0px), 8px);
      gap: 6px;
    }
    :global(.hy-gallery-counter) {
      top: max(env(safe-area-inset-top, 0px), 8px);
      left: max(env(safe-area-inset-left, 0px), 8px);
      width: 2.25rem;
      height: 2.25rem;
      font-size: 0.625rem;
    }
    :global(.hy-gallery-btn),
    :global(.hy-gallery-close) {
      width: 2.25rem;
      height: 2.25rem;
    }
    :global(.hy-gallery-nav) {
      width: 2.25rem;
      height: 2.25rem;
    }
    :global(.hy-gallery-nav-prev) {
      left: max(env(safe-area-inset-left, 0px), 8px);
    }
    :global(.hy-gallery-nav-next) {
      right: max(env(safe-area-inset-right, 0px), 8px);
    }
  }
</style>

<script>
  class GalleryLightbox {
    gallery: HTMLElement;
    items: HTMLButtonElement[];
    overlay: HTMLElement | null;
    imgEl: HTMLImageElement | null;
    counterEl: HTMLElement | null;
    prevBtn: HTMLButtonElement | null;
    nextBtn: HTMLButtonElement | null;
    zoomControls: HTMLElement | null;
    zoomInBtn: HTMLButtonElement | null;
    zoomOutBtn: HTMLButtonElement | null;
    zoomResetBtn: HTMLButtonElement | null;
    closeBtn: HTMLButtonElement | null;
    currentIndex: number;
    zoomEnabled: boolean;
    zoomControlsEnabled: boolean;

    // Zoom & pan state
    scale: number;
    translateX: number;
    translateY: number;

    // Touch tracking
    touchStartX: number;
    touchStartY: number;
    touchLastX: number;
    touchLastY: number;
    isPinching: boolean;
    isDragging: boolean;
    pinchStartDist: number;
    pinchStartScale: number;
    pinchStartCenter: { x: number; y: number };
    pinchStartTranslate: { x: number; y: number };
    lastTapTime: number;

    // Mouse tracking
    isMouseDown: boolean;
    mouseStartX: number;
    mouseStartY: number;
    mouseLastX: number;
    mouseLastY: number;
    hasMouseDragged: boolean;
    isAnimating: boolean;

    // Body scroll lock state
    lockedScrollY: number;
    previousBodyOverflow: string;
    previousBodyPosition: string;
    previousBodyTop: string;
    previousBodyWidth: string;
    previousHtmlOverflow: string;
    previousHtmlScrollBehavior: string;

    constructor(el: HTMLElement) {
      this.gallery = el;
      this.zoomEnabled = el.dataset.zoom !== "false";
      this.zoomControlsEnabled = el.dataset.zoomControls === "true";
      this.items = Array.from(
        el.querySelectorAll<HTMLButtonElement>(".hy-gallery-item"),
      );
      this.overlay = null;
      this.imgEl = null;
      this.counterEl = null;
      this.prevBtn = null;
      this.nextBtn = null;
      this.zoomControls = null;
      this.zoomInBtn = null;
      this.zoomOutBtn = null;
      this.zoomResetBtn = null;
      this.closeBtn = null;
      this.currentIndex = -1;

      this.scale = 1;
      this.translateX = 0;
      this.translateY = 0;

      this.touchStartX = 0;
      this.touchStartY = 0;
      this.touchLastX = 0;
      this.touchLastY = 0;
      this.isPinching = false;
      this.isDragging = false;
      this.pinchStartDist = 0;
      this.pinchStartScale = 1;
      this.pinchStartCenter = { x: 0, y: 0 };
      this.pinchStartTranslate = { x: 0, y: 0 };
      this.lastTapTime = 0;

      this.isMouseDown = false;
      this.mouseStartX = 0;
      this.mouseStartY = 0;
      this.mouseLastX = 0;
      this.mouseLastY = 0;
      this.hasMouseDragged = false;
      this.isAnimating = false;

      this.lockedScrollY = -1;
      this.previousBodyOverflow = "";
      this.previousBodyPosition = "";
      this.previousBodyTop = "";
      this.previousBodyWidth = "";
      this.previousHtmlOverflow = "";
      this.previousHtmlScrollBehavior = "";

      this.bind();
      document.addEventListener("astro:before-swap", this.forceClose);
    }

    bind = () => {
      this.gallery.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
          ".hy-gallery-item",
        );
        if (!btn) return;
        const index = this.items.indexOf(btn);
        if (index > -1) this.open(index);
      });
    };

    getContentCenter = () => {
      return {
        x: window.innerWidth / 2,
        y: window.innerHeight / 2,
      };
    };

    applyTransform = (withTransition = false) => {
      if (!this.imgEl) return;
      if (withTransition) {
        this.imgEl.style.transition =
          "transform 0.28s cubic-bezier(0.16, 1, 0.3, 1)";
      } else {
        this.imgEl.style.transition = "none";
      }
      this.imgEl.style.transform = `translate3d(${this.translateX}px, ${this.translateY}px, 0px) scale(${this.scale})`;
    };

    animateTo = (targetScale: number, targetTx: number, targetTy: number) => {
      this.scale = targetScale;
      this.translateX = targetTx;
      this.translateY = targetTy;
      this.isAnimating = true;
      this.applyTransform(true);
      this.updateZoomUI();
      window.setTimeout(() => {
        this.isAnimating = false;
        if (this.imgEl && !this.isPinching && !this.isMouseDown) {
          this.imgEl.style.transition = "";
        }
      }, 300);
    };

    resetZoom = (animated = false) => {
      if (animated) {
        this.animateTo(1, 0, 0);
      } else {
        this.scale = 1;
        this.translateX = 0;
        this.translateY = 0;
        this.applyTransform(false);
        this.updateZoomUI();
      }
    };

    clampToBounds = (animate = false) => {
      if (!this.imgEl) return;
      if (this.scale <= 1.01) {
        if (animate) {
          this.animateTo(1, 0, 0);
        } else {
          this.resetZoom(false);
        }
        return;
      }

      const baseW = this.imgEl.offsetWidth || this.imgEl.naturalWidth || 800;
      const baseH = this.imgEl.offsetHeight || this.imgEl.naturalHeight || 600;
      const scaledW = baseW * this.scale;
      const scaledH = baseH * this.scale;

      const vpW = window.innerWidth;
      const vpH = window.innerHeight;

      const maxTx = Math.max(0, (scaledW - vpW) / 2 + 24);
      const maxTy = Math.max(0, (scaledH - vpH) / 2 + 24);

      const clampedTx = Math.min(maxTx, Math.max(-maxTx, this.translateX));
      const clampedTy = Math.min(maxTy, Math.max(-maxTy, this.translateY));

      if (animate) {
        this.animateTo(this.scale, clampedTx, clampedTy);
      } else {
        this.translateX = clampedTx;
        this.translateY = clampedTy;
        this.applyTransform(false);
        this.updateZoomUI();
      }
    };

    zoomBy = (factor: number) => {
      if (!this.zoomEnabled) return;
      const newScale = Math.min(5.0, Math.max(1.0, this.scale * factor));
      if (newScale <= 1.01) {
        this.resetZoom(true);
        return;
      }
      const ratio = newScale / this.scale;
      this.scale = newScale;
      this.translateX = this.translateX * ratio;
      this.translateY = this.translateY * ratio;
      this.clampToBounds(true);
    };

    panBy = (dx: number, dy: number) => {
      this.translateX += dx;
      this.translateY += dy;
      this.clampToBounds(true);
    };

    handleDoubleTap = (clientX: number, clientY: number) => {
      if (!this.zoomEnabled) return;
      if (this.scale > 1.15) {
        this.resetZoom(true);
      } else {
        const targetScale = 2.5;
        const center = this.getContentCenter();
        const targetTx = clientX - center.x - targetScale * (clientX - center.x);
        const targetTy = clientY - center.y - targetScale * (clientY - center.y);
        this.scale = targetScale;
        this.translateX = targetTx;
        this.translateY = targetTy;
        this.clampToBounds(true);
      }
    };

    updateZoomUI = () => {
      if (!this.zoomEnabled) return;
      if (this.zoomOutBtn) {
        const disabled = this.scale <= 1.01;
        this.zoomOutBtn.disabled = disabled;
        this.zoomOutBtn.setAttribute("aria-disabled", disabled ? "true" : "false");
      }
      if (this.zoomInBtn) {
        const disabled = this.scale >= 4.95;
        this.zoomInBtn.disabled = disabled;
        this.zoomInBtn.setAttribute("aria-disabled", disabled ? "true" : "false");
      }
      if (this.zoomResetBtn) {
        const isZoomed = this.scale > 1.01;
        this.zoomResetBtn.disabled = !isZoomed;
        this.zoomResetBtn.setAttribute("aria-disabled", !isZoomed ? "true" : "false");
        const title = isZoomed
          ? `Reset zoom (${Math.round(this.scale * 100)}%)`
          : "Reset zoom";
        this.zoomResetBtn.title = title;
        this.zoomResetBtn.setAttribute("aria-label", title);
      }
      if (this.imgEl) {
        if (this.scale > 1.01) {
          this.imgEl.classList.add("is-zoomed");
          this.imgEl.style.cursor = this.isMouseDown ? "grabbing" : "grab";
        } else {
          this.imgEl.classList.remove("is-zoomed", "is-dragging");
          this.imgEl.style.cursor = "zoom-in";
        }
      }
    };

    forceClose = () => {
      if (this.overlay) {
        window.removeEventListener("mousemove", this.handleMouseMove);
        window.removeEventListener("mouseup", this.handleMouseUp);
        window.removeEventListener("resize", this.handleResize);
        document.removeEventListener("keydown", this.handleKey);
        document.removeEventListener("gesturestart", this.preventZoom);

        this.overlay.remove();
        this.overlay = null;
        this.imgEl = null;
        this.counterEl = null;
        this.zoomControls = null;
        this.zoomInBtn = null;
        this.zoomOutBtn = null;
        this.zoomResetBtn = null;
        this.closeBtn = null;

        const main = document.querySelector("main");
        if (main) main.removeAttribute("inert");
      }
      this.unlockBackgroundScroll();
      document.removeEventListener("astro:before-swap", this.forceClose);
    };

    open = (index: number) => {
      this.currentIndex = index;
      const src = this.items[index].dataset.zoomSrc || "";
      const alt = this.items[index].dataset.alt || "";

      this.buildOverlay();
      if (!this.imgEl || !this.overlay) return;

      this.imgEl.src = src;
      this.imgEl.alt = alt;
      this.resetZoom(false);
      this.updateCounter();
      this.updateNavButtons();
      this.preload(index + 1);

      document.body.appendChild(this.overlay);
      this.lockBackgroundScroll();
      const main = document.querySelector("main");
      if (main) main.setAttribute("inert", "");
      this.overlay.focus();

      document.addEventListener("gesturestart", this.preventZoom, {
        passive: false,
      });

      requestAnimationFrame(() => {
        this.overlay?.classList.add("is-active");
      });
    };

    buildOverlay = () => {
      if (this.overlay) return;

      this.overlay = document.createElement("div");
      this.overlay.className = "hy-gallery-overlay";
      this.overlay.tabIndex = -1;
      this.overlay.setAttribute("role", "dialog");
      this.overlay.setAttribute("aria-modal", "true");
      this.overlay.setAttribute("aria-label", "Image viewer");

      // Counter (top left)
      this.counterEl = document.createElement("div");
      this.counterEl.className = "hy-gallery-counter";
      this.counterEl.setAttribute("aria-hidden", "true");

      // Controls (top right)
      this.zoomControls = document.createElement("div");
      this.zoomControls.className = "hy-gallery-controls";

      if (this.zoomEnabled && this.zoomControlsEnabled) {
        this.zoomOutBtn = document.createElement("button");
        this.zoomOutBtn.className = "hy-gallery-btn hy-gallery-zoom-out";
        this.zoomOutBtn.setAttribute("type", "button");
        this.zoomOutBtn.setAttribute("aria-label", "Zoom out");
        this.zoomOutBtn.title = "Zoom out (-)";
        this.zoomOutBtn.disabled = true;
        this.zoomOutBtn.setAttribute("aria-disabled", "true");
        this.zoomOutBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>`;
        this.zoomOutBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          this.zoomBy(1 / 1.5);
        });

        this.zoomInBtn = document.createElement("button");
        this.zoomInBtn.className = "hy-gallery-btn hy-gallery-zoom-in";
        this.zoomInBtn.setAttribute("type", "button");
        this.zoomInBtn.setAttribute("aria-label", "Zoom in");
        this.zoomInBtn.title = "Zoom in (+)";
        this.zoomInBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>`;
        this.zoomInBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          this.zoomBy(1.5);
        });

        this.zoomResetBtn = document.createElement("button");
        this.zoomResetBtn.className = "hy-gallery-btn hy-gallery-zoom-reset";
        this.zoomResetBtn.setAttribute("type", "button");
        this.zoomResetBtn.setAttribute("aria-label", "Reset zoom");
        this.zoomResetBtn.title = "Reset zoom (0)";
        this.zoomResetBtn.disabled = true;
        this.zoomResetBtn.setAttribute("aria-disabled", "true");
        this.zoomResetBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>`;
        this.zoomResetBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          this.resetZoom(true);
        });

        this.zoomControls.append(this.zoomOutBtn, this.zoomInBtn, this.zoomResetBtn);
      }

      this.closeBtn = document.createElement("button");
      this.closeBtn.className = "hy-gallery-close";
      this.closeBtn.setAttribute("type", "button");
      this.closeBtn.setAttribute("aria-label", "Close");
      this.closeBtn.title = "Close (ESC)";
      this.closeBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;
      this.closeBtn.addEventListener("click", this.close);
      this.zoomControls.appendChild(this.closeBtn);

      this.prevBtn = document.createElement("button");
      this.prevBtn.className = "hy-gallery-nav hy-gallery-nav-prev";
      this.prevBtn.setAttribute("type", "button");
      this.prevBtn.setAttribute("aria-label", "Previous image");
      this.prevBtn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>`;
      this.prevBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        this.navigate(-1);
      });

      this.nextBtn = document.createElement("button");
      this.nextBtn.className = "hy-gallery-nav hy-gallery-nav-next";
      this.nextBtn.setAttribute("type", "button");
      this.nextBtn.setAttribute("aria-label", "Next image");
      this.nextBtn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>`;
      this.nextBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        this.navigate(1);
      });

      const content = document.createElement("div");
      content.className = "hy-gallery-overlay-content";

      this.imgEl = document.createElement("img");
      this.imgEl.className = "hy-gallery-overlay-img";
      this.imgEl.setAttribute("decoding", "sync");

      content.appendChild(this.imgEl);
      this.overlay.append(
        this.counterEl,
        this.zoomControls,
        this.prevBtn,
        this.nextBtn,
        content,
      );

      if (this.items.length <= 1) {
        this.prevBtn.style.display = "none";
        this.nextBtn.style.display = "none";
        this.counterEl.style.display = "none";
      }

      this.overlay.addEventListener("click", this.handleOverlayClick);
      this.overlay.addEventListener("wheel", this.handleWheel, { passive: false });
      this.overlay.addEventListener("touchstart", this.handleTouchStart, {
        passive: false,
      });
      this.overlay.addEventListener("touchmove", this.handleTouchMove, {
        passive: false,
      });
      this.overlay.addEventListener("touchend", this.handleTouchEnd, {
        passive: false,
      });
      this.overlay.addEventListener("touchcancel", this.handleTouchEnd, {
        passive: false,
      });
      this.overlay.addEventListener("mousedown", this.handleMouseDown);
      this.overlay.addEventListener("dblclick", this.handleDblClick);
      window.addEventListener("mousemove", this.handleMouseMove);
      window.addEventListener("mouseup", this.handleMouseUp);
      window.addEventListener("resize", this.handleResize);
      document.addEventListener("keydown", this.handleKey);
    };

    close = () => {
      if (!this.overlay) return;

      this.overlay.classList.remove("is-active");
      this.resetZoom(true);

      setTimeout(() => {
        if (this.overlay) {
          window.removeEventListener("mousemove", this.handleMouseMove);
          window.removeEventListener("mouseup", this.handleMouseUp);
          window.removeEventListener("resize", this.handleResize);
          document.removeEventListener("keydown", this.handleKey);
          document.removeEventListener("gesturestart", this.preventZoom);

          this.overlay.parentNode?.removeChild(this.overlay);
          this.overlay = null;
          this.imgEl = null;
          this.counterEl = null;
          this.zoomControls = null;
          this.zoomInBtn = null;
          this.zoomOutBtn = null;
          this.zoomResetBtn = null;
          this.closeBtn = null;
        }

        this.unlockBackgroundScroll();
        const main = document.querySelector("main");
        if (main) main.removeAttribute("inert");

        if (this.currentIndex >= 0 && this.currentIndex < this.items.length) {
          this.items[this.currentIndex].focus();
        }
      }, 300);
    };

    lockBackgroundScroll = () => {
      if (this.lockedScrollY >= 0) return;

      this.lockedScrollY = window.scrollY;
      this.previousBodyOverflow = document.body.style.overflow;
      this.previousBodyPosition = document.body.style.position;
      this.previousBodyTop = document.body.style.top;
      this.previousBodyWidth = document.body.style.width;
      this.previousHtmlOverflow = document.documentElement.style.overflow;
      this.previousHtmlScrollBehavior = document.documentElement.style.scrollBehavior;

      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
      document.body.style.position = "fixed";
      document.body.style.top = `-${this.lockedScrollY}px`;
      document.body.style.width = "100%";
    };

    unlockBackgroundScroll = () => {
      if (this.lockedScrollY < 0) return;

      document.documentElement.style.overflow = this.previousHtmlOverflow;
      document.body.style.overflow = this.previousBodyOverflow;
      document.body.style.position = this.previousBodyPosition;
      document.body.style.top = this.previousBodyTop;
      document.body.style.width = this.previousBodyWidth;
      document.documentElement.style.scrollBehavior = "auto";
      window.scrollTo({ top: this.lockedScrollY, left: 0, behavior: "auto" });
      requestAnimationFrame(() => {
        document.documentElement.style.scrollBehavior =
          this.previousHtmlScrollBehavior;
      });
      this.lockedScrollY = -1;
    };

    navigate = (dir: number) => {
      const next = this.currentIndex + dir;
      if (next < 0 || next >= this.items.length) return;

      this.currentIndex = next;
      const content = this.overlay?.querySelector(".hy-gallery-overlay-content");
      if (!content || !this.imgEl) return;

      this.resetZoom(false);

      const oldImg = this.imgEl;
      this.imgEl = document.createElement("img");
      this.imgEl.className = "hy-gallery-overlay-img hy-gallery-slide-anim";
      this.imgEl.setAttribute("decoding", "sync");

      const src = this.items[next].dataset.zoomSrc || "";
      const alt = this.items[next].dataset.alt || "";

      this.imgEl.src = src;
      this.imgEl.alt = alt;

      content.replaceChild(this.imgEl, oldImg);

      this.imgEl.addEventListener(
        "animationend",
        () => {
          this.imgEl?.classList.remove("hy-gallery-slide-anim");
        },
        { once: true },
      );

      this.updateCounter();
      this.updateNavButtons();
      this.updateZoomUI();
      this.preload(next + dir);
    };

    preload = (index: number) => {
      if (index >= 0 && index < this.items.length) {
        const nextSrc = this.items[index].dataset.zoomSrc;
        if (nextSrc) new Image().src = nextSrc;
      }
    };

    updateNavButtons = () => {
      if (!this.prevBtn || !this.nextBtn) return;
      this.prevBtn.style.visibility = this.currentIndex <= 0 ? "hidden" : "";
      this.nextBtn.style.visibility =
        this.currentIndex >= this.items.length - 1 ? "hidden" : "";
    };

    updateCounter = () => {
      if (this.counterEl) {
        this.counterEl.textContent = `${this.currentIndex + 1}/${this.items.length}`;
      }
    };

    handleOverlayClick = (e: MouseEvent) => {
      if (this.hasMouseDragged) {
        this.hasMouseDragged = false;
        return;
      }
      const target = e.target as HTMLElement;
      if (
        target.classList.contains("hy-gallery-overlay") ||
        target.classList.contains("hy-gallery-overlay-content")
      ) {
        this.close();
      }
    };

    handleKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        if (this.scale > 1.05) {
          this.resetZoom(true);
        } else {
          this.close();
        }
      } else if (e.key === "+" || e.key === "=") {
        this.zoomBy(1.3);
      } else if (e.key === "-" || e.key === "_") {
        this.zoomBy(1 / 1.3);
      } else if (e.key === "0") {
        this.resetZoom(true);
      } else if (e.key === "ArrowLeft") {
        if (this.scale > 1.05) {
          this.panBy(60, 0);
        } else {
          this.navigate(-1);
        }
      } else if (e.key === "ArrowRight") {
        if (this.scale > 1.05) {
          this.panBy(-60, 0);
        } else {
          this.navigate(1);
        }
      } else if (e.key === "ArrowUp" && this.scale > 1.05) {
        this.panBy(0, 60);
      } else if (e.key === "ArrowDown" && this.scale > 1.05) {
        this.panBy(0, -60);
      }
    };

    handleTouchStart = (e: TouchEvent) => {
      const target = e.target as HTMLElement;
      if (target.closest(".hy-gallery-btn, .hy-gallery-close, .hy-gallery-nav")) {
        return;
      }

      if (e.touches.length === 1) {
        this.touchStartX = e.touches[0].clientX;
        this.touchStartY = e.touches[0].clientY;
        this.touchLastX = e.touches[0].clientX;
        this.touchLastY = e.touches[0].clientY;
        this.isDragging = false;
        this.isPinching = false;
      } else if (e.touches.length === 2 && this.zoomEnabled) {
        this.isPinching = true;
        this.isDragging = false;
        const t1 = e.touches[0];
        const t2 = e.touches[1];
        this.pinchStartDist = Math.hypot(
          t2.clientX - t1.clientX,
          t2.clientY - t1.clientY,
        );
        this.pinchStartScale = this.scale;
        this.pinchStartCenter = {
          x: (t1.clientX + t2.clientX) / 2,
          y: (t1.clientY + t2.clientY) / 2,
        };
        this.pinchStartTranslate = { x: this.translateX, y: this.translateY };
        this.applyTransform(false);
      }
    };

    handleTouchMove = (e: TouchEvent) => {
      if (this.isPinching && e.touches.length >= 2) {
        e.preventDefault();
        const t1 = e.touches[0];
        const t2 = e.touches[1];
        const currDist = Math.hypot(
          t2.clientX - t1.clientX,
          t2.clientY - t1.clientY,
        );
        const ratio = currDist / (this.pinchStartDist || 1);
        const rawScale = this.pinchStartScale * ratio;
        const clampedScale = Math.min(5.5, Math.max(0.75, rawScale));

        const currCenter = {
          x: (t1.clientX + t2.clientX) / 2,
          y: (t1.clientY + t2.clientY) / 2,
        };
        const center = this.getContentCenter();

        const T_x =
          currCenter.x -
          center.x -
          (clampedScale / this.pinchStartScale) *
            (this.pinchStartCenter.x - center.x - this.pinchStartTranslate.x);
        const T_y =
          currCenter.y -
          center.y -
          (clampedScale / this.pinchStartScale) *
            (this.pinchStartCenter.y - center.y - this.pinchStartTranslate.y);

        this.scale = clampedScale;
        this.translateX = T_x;
        this.translateY = T_y;
        this.applyTransform(false);
        this.updateZoomUI();
      } else if (!this.isPinching && e.touches.length === 1) {
        const touch = e.touches[0];
        if (this.scale > 1.01) {
          e.preventDefault();
          const dx = touch.clientX - this.touchLastX;
          const dy = touch.clientY - this.touchLastY;
          this.touchLastX = touch.clientX;
          this.touchLastY = touch.clientY;
          this.translateX += dx;
          this.translateY += dy;
          this.isDragging = true;
          this.applyTransform(false);
        }
      }
    };

    handleTouchEnd = (e: TouchEvent) => {
      if (this.isPinching) {
        if (e.touches.length < 2) {
          this.isPinching = false;
          if (e.touches.length === 1) {
            this.touchLastX = e.touches[0].clientX;
            this.touchLastY = e.touches[0].clientY;
            this.touchStartX = e.touches[0].clientX;
            this.touchStartY = e.touches[0].clientY;
          }
          if (this.scale < 1.0) {
            this.resetZoom(true);
          } else if (this.scale > 5.0) {
            this.scale = 5.0;
            this.clampToBounds(true);
          } else {
            this.clampToBounds(true);
          }
        }
        return;
      }

      if (e.changedTouches.length === 1) {
        const touch = e.changedTouches[0];
        const tapDist = Math.hypot(
          touch.clientX - this.touchStartX,
          touch.clientY - this.touchStartY,
        );

        if (tapDist < 15 && !this.isDragging) {
          const now = Date.now();
          if (now - this.lastTapTime < 300) {
            this.handleDoubleTap(touch.clientX, touch.clientY);
            this.lastTapTime = 0;
            return;
          }
          this.lastTapTime = now;
        }

        if (this.scale > 1.01) {
          this.clampToBounds(true);
        } else {
          const diffX = touch.clientX - this.touchStartX;
          const diffY = touch.clientY - this.touchStartY;
          if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
            if (diffX > 0) this.navigate(-1);
            else this.navigate(1);
          }
        }
      }
    };

    handleWheel = (e: WheelEvent) => {
      if (!this.overlay || !this.imgEl || !this.zoomEnabled) return;
      e.preventDefault();
      const isPinch = e.ctrlKey;
      const factor = isPinch
        ? Math.exp(-e.deltaY * 0.015)
        : e.deltaY < 0
          ? 1.2
          : 0.833;

      const targetScale = Math.min(5.0, Math.max(1.0, this.scale * factor));
      if (Math.abs(targetScale - this.scale) < 0.001) return;

      if (targetScale <= 1.01) {
        this.resetZoom(true);
        return;
      }

      const center = this.getContentCenter();
      const T_x =
        e.clientX -
        center.x -
        (targetScale / this.scale) * (e.clientX - center.x - this.translateX);
      const T_y =
        e.clientY -
        center.y -
        (targetScale / this.scale) * (e.clientY - center.y - this.translateY);

      this.scale = targetScale;
      this.translateX = T_x;
      this.translateY = T_y;
      this.clampToBounds(false);
      this.updateZoomUI();
    };

    handleMouseDown = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      if (target.closest(".hy-gallery-btn, .hy-gallery-close, .hy-gallery-nav")) {
        return;
      }
      if (e.button !== 0) return;
      if (this.scale <= 1.01) return;

      this.isMouseDown = true;
      this.mouseStartX = e.clientX;
      this.mouseStartY = e.clientY;
      this.mouseLastX = e.clientX;
      this.mouseLastY = e.clientY;
      this.hasMouseDragged = false;
      if (this.imgEl) {
        this.imgEl.classList.add("is-dragging");
        this.imgEl.style.cursor = "grabbing";
        this.imgEl.style.transition = "none";
      }
      e.preventDefault();
    };

    handleMouseMove = (e: MouseEvent) => {
      if (!this.isMouseDown) return;
      const dx = e.clientX - this.mouseLastX;
      const dy = e.clientY - this.mouseLastY;
      if (
        Math.hypot(e.clientX - this.mouseStartX, e.clientY - this.mouseStartY) >
        5
      ) {
        this.hasMouseDragged = true;
      }
      this.mouseLastX = e.clientX;
      this.mouseLastY = e.clientY;
      this.translateX += dx;
      this.translateY += dy;
      this.applyTransform(false);
    };

    handleMouseUp = () => {
      if (!this.isMouseDown) return;
      this.isMouseDown = false;
      if (this.imgEl) {
        this.imgEl.classList.remove("is-dragging");
        this.imgEl.style.cursor = this.scale > 1.01 ? "grab" : "zoom-in";
      }
      this.clampToBounds(true);
    };

    handleDblClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      if (target.closest(".hy-gallery-btn, .hy-gallery-close, .hy-gallery-nav")) {
        return;
      }
      if (!this.zoomEnabled) return;
      e.preventDefault();
      e.stopPropagation();
      this.handleDoubleTap(e.clientX, e.clientY);
    };

    handleResize = () => {
      if (this.scale > 1.01) {
        this.clampToBounds(false);
      }
    };

    preventZoom = (e: Event) => {
      if (e.type === "gesturestart") {
        e.preventDefault();
      }
    };
  }

  function initGalleries() {
    document.querySelectorAll("[data-hy-gallery]").forEach((el) => {
      if (!el.hasAttribute("data-hy-gallery-bound")) {
        el.setAttribute("data-hy-gallery-bound", "");
        new GalleryLightbox(el as HTMLElement);
      }
    });
  }

  initGalleries();
  document.addEventListener("astro:page-load", initGalleries);
</script>
